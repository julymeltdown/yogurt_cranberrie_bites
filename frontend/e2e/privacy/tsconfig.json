{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "*": ["./node_modules/*"]
    },
    "types": ["vite/client"],
    "incremental": false
  },
  "include": ["./*.ts"],
  "exclude": []
}

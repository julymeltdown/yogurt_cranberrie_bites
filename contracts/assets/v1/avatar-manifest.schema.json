{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcr.invalid/assets/v1/avatar-manifest.schema.json",
  "title": "MCR AvatarManifest v1",
  "$ref": "#/$defs/AvatarManifest",
  "$defs": {
    "AvatarManifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/LayeredAvatarManifest"
        },
        {
          "$ref": "#/$defs/WholeCharacterAvatarManifest"
        }
      ]
    },
    "LayeredAvatarManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "manifest_id",
        "manifest_version",
        "content_hash",
        "provenance",
        "layer_order",
        "skin_tones",
        "atlas",
        "presets",
        "fallback_preset_id"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "avatar_manifest"
        },
        "manifest_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "manifest_version": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "provenance": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Provenance"
        },
        "layer_order": {
          "const": [
            "body",
            "eyes",
            "hair",
            "outfit",
            "accessory"
          ]
        },
        "skin_tones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skin_tone_id",
              "color"
            ],
            "properties": {
              "skin_tone_id": {
                "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              }
            }
          }
        },
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atlas_id",
            "cell",
            "anchor",
            "frame_layout",
            "texture",
            "items"
          ],
          "properties": {
            "atlas_id": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
            },
            "cell": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Cell"
            },
            "anchor": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Anchor"
            },
            "frame_layout": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction_order",
                "idle_column",
                "walk_columns"
              ],
              "properties": {
                "direction_order": {
                  "const": [
                    "down",
                    "left",
                    "right",
                    "up"
                  ]
                },
                "idle_column": {
                  "const": 0
                },
                "walk_columns": {
                  "const": [
                    1,
                    2,
                    3,
                    4
                  ]
                }
              }
            },
            "texture": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/TextureMetadata"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item_id",
                  "layer_id",
                  "anchor",
                  "region"
                ],
                "properties": {
                  "item_id": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
                  },
                  "layer_id": {
                    "enum": [
                      "body",
                      "eyes",
                      "hair",
                      "outfit",
                      "accessory"
                    ]
                  },
                  "anchor": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Anchor"
                  },
                  "region": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "width_px",
                      "height_px"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "width_px": {
                        "const": 320
                      },
                      "height_px": {
                        "const": 256
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preset_id",
              "config"
            ],
            "properties": {
              "preset_id": {
                "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
              },
              "config": {
                "$ref": "https://contracts.mcr.invalid/assets/v1/avatar-config.schema.json#/$defs/AvatarConfig"
              }
            }
          }
        },
        "fallback_preset_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        }
      }
    },
    "WholeCharacterAvatarManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "manifest_id",
        "manifest_version",
        "representation",
        "source",
        "capabilities",
        "content_hash",
        "atlas",
        "presets",
        "default_preset_id"
      ],
      "properties": {
        "contract_version": {
          "const": "1.1.0"
        },
        "kind": {
          "const": "avatar_manifest"
        },
        "manifest_id": {
          "const": "mcr_selected_static_20261103"
        },
        "manifest_version": {
          "const": 1
        },
        "representation": {
          "const": "whole_character"
        },
        "source": {
          "const": {
            "source_pack_id": "mcr_user_characters_20261103",
            "source_pack_revision": 3,
            "source_id": "photo_01",
            "source_sha256": "sha256:67448360482a0dd68172d6089378a002190142bb8bd804818c89a86370154311",
            "release_path": "world/avatars/derived-v1/static-release.json",
            "release_sha256": "sha256:cc53c6852742e9cbb9858a2d0961411e1a9e131d1e30c0f2b73b265e03f91677",
            "source_commit": "7e07f7328f079991a9aedb7ad83a4b682decb543"
          }
        },
        "capabilities": {
          "const": {
            "poses": [
              "front_idle"
            ],
            "layer_customization": false,
            "skin_tone_customization": false
          }
        },
        "content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atlas_id",
            "cell",
            "anchor",
            "texture"
          ],
          "properties": {
            "atlas_id": {
              "const": "mcr_selected_static_front_idle_64"
            },
            "cell": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Cell"
            },
            "anchor": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Anchor"
            },
            "texture": {
              "allOf": [
                {
                  "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/TextureMetadata"
                },
                {
                  "const": {
                    "image_state": "PROVIDED",
                    "path": "world/avatars/derived-v1/photo01-front-idle-64-e124c88815b22220.png",
                    "sha256": "sha256:e124c88815b22220df2f2dc59e2f26b3ceb845e57b77674fd8e55383116d7efe",
                    "width_px": 384,
                    "height_px": 64
                  }
                }
              ]
            }
          }
        },
        "presets": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WholeCharacterPreset"
          }
        },
        "default_preset_id": {
          "enum": [
            "photo01_front_01",
            "photo01_front_02",
            "photo01_front_03",
            "photo01_front_04",
            "photo01_front_05",
            "photo01_front_06"
          ]
        }
      }
    },
    "WholeCharacterPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "config",
        "art_id",
        "frame"
      ],
      "properties": {
        "preset_id": {
          "enum": [
            "photo01_front_01",
            "photo01_front_02",
            "photo01_front_03",
            "photo01_front_04",
            "photo01_front_05",
            "photo01_front_06"
          ]
        },
        "config": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/avatar-config.schema.json#/$defs/WholeCharacterAvatarConfig"
        },
        "art_id": {
          "enum": [
            "photo01-front-01",
            "photo01-front-02",
            "photo01-front-03",
            "photo01-front-04",
            "photo01-front-05",
            "photo01-front-06"
          ]
        },
        "frame": {
          "$ref": "#/$defs/WholeCharacterFrame"
        }
      },
      "oneOf": [
        {
          "const": {
            "preset_id": "photo01_front_01",
            "config": {
              "contract_version": "1.1.0",
              "kind": "avatar_config",
              "manifest_id": "mcr_selected_static_20261103",
              "manifest_version": 1,
              "representation": "whole_character",
              "preset_id": "photo01_front_01"
            },
            "art_id": "photo01-front-01",

            }
          }
        },
        {
          "const": {
            "preset_id": "photo01_front_04",
            "config": {
              "contract_version": "1.1.0",
              "kind": "avatar_config",
              "manifest_id": "mcr_selected_static_20261103",
              "manifest_version": 1,
              "representation": "whole_character",
              "preset_id": "photo01_front_04"
            },
            "art_id": "photo01-front-04",
            "frame": {
              "x": 192,
              "y": 0,
              "width_px": 64,
              "height_px": 64
            }
          }
        },
        {
          "const": {
            "preset_id": "photo01_front_05",
            "config": {
              "contract_version": "1.1.0",
              "kind": "avatar_config",
              "manifest_id": "mcr_selected_static_20261103",
              "manifest_version": 1,
              "representation": "whole_character",
              "preset_id": "photo01_front_05"
            },
            "art_id": "photo01-front-05",
            "frame": {
              "x": 256,
              "y": 0,
              "width_px": 64,
              "height_px": 64
            }
          }
        },
        {
          "const": {
            "preset_id": "photo01_front_06",
            "config": {
              "contract_version": "1.1.0",
              "kind": "avatar_config",
              "manifest_id": "mcr_selected_static_20261103",
              "manifest_version": 1,
              "representation": "whole_character",
              "preset_id": "photo01_front_06"
            },
            "art_id": "photo01-front-06",
            "frame": {
              "x": 320,
              "y": 0,
              "width_px": 64,
              "height_px": 64
            }
          }
        }
      ]
    },
    "WholeCharacterFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width_px",
        "height_px"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "const": 0
        },
        "width_px": {
          "const": 64
        },
        "height_px": {
          "const": 64
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcr.invalid/assets/v1/map-manifest.schema.json",
  "title": "MCR MapManifest v1",
  "$ref": "#/$defs/MapManifest",
  "$defs": {
    "MapManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "map_id",
        "map_revision",
        "content_hash",
        "geometry_hash",
        "provenance",
        "tilemap",
        "geometry",
        "places"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "map_manifest"
        },
        "map_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "map_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "geometry_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "provenance": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Provenance"
        },
        "tilemap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "resource_state",
            "path",
            "sha256"
          ],
          "properties": {
            "format": {
              "const": "TILED_JSON"
            },
            "resource_state": {
              "enum": [
                "NOT_PROVIDED",
                "PROVIDED"
              ]
            },
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_/-]+\\.json$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "resource_state": {
                    "const": "NOT_PROVIDED"
                  }
                }
              },
              "then": {
                "properties": {
                  "path": {
                    "const": null
                  },
                  "sha256": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_/-]+\\.json$"
                  },
                  "sha256": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
                  }
                }
              }
            }
          ]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_cells",
            "height_cells",
            "tile_width_px",
            "tile_height_px",
            "collision_id",
            "collision_grid",
            "terrain_layer",
            "overdraw_layer",
            "spawns",
            "interactions",
            "default_spawn_id"
          ],
          "properties": {
            "width_cells": {
              "type": "integer",
              "minimum": 1
            },
            "height_cells": {
              "type": "integer",
              "minimum": 1
            },
            "tile_width_px": {
              "type": "integer",
              "minimum": 1
            },
            "tile_height_px": {
              "type": "integer",
              "minimum": 1
            },
            "collision_id": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
            },
            "collision_grid": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    0,
                    1
                  ]
                }
              }
            },
            "terrain_layer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "overdraw_layer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "spawns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "spawn_id",
                  "cell_x",
                  "cell_y"
                ],
                "properties": {
                  "spawn_id": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
                  },
                  "cell_x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cell_y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "interactions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "interaction_id",
                  "place_id",
                  "cell_x",
                  "cell_y"
                ],
                "properties": {
                  "interaction_id": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
                  },
                  "place_id": {
                    "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/PlaceId"
                  },
                  "cell_x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cell_y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "default_spawn_id": {
              "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
            }
          }
        },
        "places": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Place"
          }
        }
      }
    },
    "Place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place_id",
        "label",
        "place_kind",
        "verification_state",
        "closure_state",
        "accessibility_notes",
        "provenance"
      ],
      "properties": {
        "place_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/PlaceId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "place_kind": {
          "enum": [
            "VIRTUAL_CONCEPT",
            "PHYSICAL"
          ]
        },
        "verification_state": {
          "enum": [
            "CONCEPT_ONLY",
            "UNVERIFIED",
            "VERIFIED"
          ]
        },
        "closure_state": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "accessibility_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provenance": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "place_kind": {
                "const": "VIRTUAL_CONCEPT"
              }
            }
          },
          "then": {
            "properties": {
              "verification_state": {
                "const": "CONCEPT_ONLY"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "place_kind": {
                "const": "PHYSICAL"
              }
            }
          },
          "then": {
            "properties": {
              "verification_state": {
                "enum": [
                  "UNVERIFIED",
                  "VERIFIED"
                ]
              },
              "provenance": {
                "properties": {
                  "source_kind": {
                    "const": "PLACE_REFERENCE"
                  },
                  "source_uri": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification_state": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "place_kind": {
                "const": "PHYSICAL"
              },
              "provenance": {
                "properties": {
                  "review_state": {
                    "const": "REVIEWED"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcr.invalid/assets/v1/theme-manifest.schema.json",
  "title": "MCR ThemeManifest v1",
  "$ref": "#/$defs/ThemeManifest",
  "$defs": {
    "ThemeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "theme_id",
        "theme_revision",
        "content_hash",
        "provenance",
        "map_id",
        "map_revision",
        "map_content_hash",
        "geometry_hash",
        "collision_id",
        "place_ids",
        "interaction_ids",
        "avatar_manifest_id",
        "avatar_manifest_version",
        "avatar_content_hash",
        "texture",
        "palette"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "theme_manifest"
        },
        "theme_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ThemeId"
        },
        "theme_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "provenance": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Provenance"
        },
        "map_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "map_revision": {
          "type": "integer",
          "minimum": 1
        },
        "map_content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "geometry_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "collision_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "place_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/PlaceId"
          }
        },
        "interaction_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
          }
        },
        "avatar_manifest_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "avatar_manifest_version": {
          "type": "integer",
          "minimum": 1
        },
        "avatar_content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "texture": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/TextureMetadata"
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "terrain",
            "accent"
          ],
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "terrain": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            }
          }
        },
        "scenery": {
          "$ref": "#/$defs/Scenery"
        }
      }
    },
    "SceneryTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "width_px",
        "height_px",
        "bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^world/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.png$",
          "maxLength": 512
        },
        "sha256": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "SceneryObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "atlas_id",
        "frame",
        "x",
        "y",
        "width",
        "height",
        "depth_y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "atlas_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          }
        },
        "x": {
          "type": "integer",
          "minimum": -128,
          "maximum": 16512
        },
        "y": {
          "type": "integer",
          "minimum": -128,
          "maximum": 16512
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "depth_y": {
          "type": "integer",
          "minimum": -1,
          "maximum": 16512
        }
      }
    },
    "Scenery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ground",
        "atlases",
        "objects"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "ground": {
          "$ref": "#/$defs/SceneryTexture"
        },
        "atlases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SceneryTexture"
          },
          "maxItems": 3
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SceneryObject"
          },
          "maxItems": 96
        }
      },
      "description": "Optional v1 illustrated skin. Loader enforces aggregate transfer/pixel budgets, unique IDs/paths, frame/world bounds and exact map-sized ground; original map geometry stays authoritative. depth_y=-1 is a ground-attached detail."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcr.invalid/assets/v1/theme-manifest.schema.json",
  "title": "MCR ThemeManifest v1",
  "$ref": "#/$defs/ThemeManifest",
  "$defs": {
    "ThemeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "theme_id",
        "theme_revision",
        "content_hash",
        "provenance",
        "map_id",
        "map_revision",
        "map_content_hash",
        "geometry_hash",
        "collision_id",
        "place_ids",
        "interaction_ids",
        "avatar_manifest_id",
        "avatar_manifest_version",
        "avatar_content_hash",
        "texture",
        "palette"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "theme_manifest"
        },
        "theme_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ThemeId"
        },
        "theme_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "provenance": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/Provenance"
        },
        "map_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "map_revision": {
          "type": "integer",
          "minimum": 1
        },
        "map_content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "geometry_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "collision_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "place_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/PlaceId"
          }
        },
        "interaction_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
          }
        },
        "avatar_manifest_id": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/AssetId"
        },
        "avatar_manifest_version": {
          "type": "integer",
          "minimum": 1
        },
        "avatar_content_hash": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/ContentHash"
        },
        "texture": {
          "$ref": "https://contracts.mcr.invalid/assets/v1/common.schema.json#/$defs/TextureMetadata"
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "terrain",
            "accent"
          ],
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "terrain": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            }
          }
        }
      }
    }
  }
}

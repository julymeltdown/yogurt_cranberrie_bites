          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "event_id",
        "status",
        "verified_at",
        "expires_at",
        "verification_available"
      ]
    },
    "StartVerification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "return_target": {
          "enum": [
            "AGE_PRIVACY"
          ]
        }
      },
      "required": [
        "return_target"
      ]
    },
    "VerificationPending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "PENDING"
          ]
        },
        "expires_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "authorization_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "verification_id",
        "state",
        "expires_at",
        "authorization_url"
      ]
    },
    "VerificationCallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "state_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider_response_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096

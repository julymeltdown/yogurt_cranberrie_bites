        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "VERIFIED",
            "REPLACED",
            "REVOKED",
            "UNSUPPORTED"
          ]
        },
        "verified_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "expires_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "age_at_verification": {
          "type": "integer",
          "minimum": 14,
          "maximum": 100
        },
        "next_birthday_at": {
          "type": "string",
          "format": "date"
        }

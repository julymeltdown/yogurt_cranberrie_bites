        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "intro_id",
        "event_id",
        "author",
        "text",
        "created_at",
        "state",
        "revision"
      ]
    },
    "IntroPrivate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },

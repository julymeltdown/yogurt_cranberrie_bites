        "grant_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "expires_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "request_id",
        "platform",
        "owner_id",
        "handle_version",
        "handle",
        "grant_revision",
        "expires_at"
      ]
    },
    "IntroList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/social.schema.json#/$defs/IntroPublic"

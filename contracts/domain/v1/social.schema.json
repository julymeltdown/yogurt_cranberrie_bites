      "required": [
        "claim_id",
        "user_id",
        "verifier_id",
        "source_revision",
        "status",
        "verified_at",
        "expires_at",
        "age_at_verification",
        "next_birthday_at"
      ]
    },
    "SetHandle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/CreationRevision"
        },
        "handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._]{1,30}$"
        }
      },
      "required": [

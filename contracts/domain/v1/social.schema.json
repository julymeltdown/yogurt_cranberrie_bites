        "requester_handle_version": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "recipient_handle_version": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "requester_consents": {
          "const": true
        }
      },
      "required": [
        "platform",
        "requester_handle_version",
        "recipient_handle_version",
        "requester_consents"
      ]
    },
    "CreateSocialRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipient_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "intro_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "intro_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "consents": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/social.schema.json#/$defs/ConsentBinding"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "recipient_id",
        "intro_id",
        "intro_revision",
        "consents"
      ]
    },
    "SocialRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "requester_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "recipient_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "consents": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/social.schema.json#/$defs/ConsentBinding"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "expires_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "created_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "state": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "CANCELLED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "intro_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "intro_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "approved_platforms": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Platform"
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "request_id",
        "event_id",
        "requester_id",
        "recipient_id",
        "consents",
        "expires_at",
        "created_at",
        "state",
        "revision",
        "intro_id",
        "intro_revision",
        "approved_platforms"
      ]
    },
    "SocialDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_platforms": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Platform"
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "recipient_consents": {
          "type": "boolean"
        }
      },
      "required": [
        "expected_revision",
        "decision",
        "approved_platforms",
        "recipient_consents"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "recipient_consents": {
                "const": true
              },
              "approved_platforms": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "recipient_consents": {
                "const": false
              },
              "approved_platforms": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },

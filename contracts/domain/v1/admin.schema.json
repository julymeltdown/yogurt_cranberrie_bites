      "required": [
        "event",
        "revision",
        "features",
        "beacon_ttl_seconds",
        "pickup_grace_seconds",
        "social_grant_ttl_seconds",
        "mural_cooldown_ms"
      ]
    },
    "SetEventSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parties": {
              "type": "boolean"
            },
            "giveaways": {
              "type": "boolean"
            },
            "intros": {
              "type": "boolean"
            },
            "social": {
              "type": "boolean"
            },
            "mural": {
              "type": "boolean"
            }
          },
          "required": [
            "parties",
            "giveaways",
            "intros",
            "social",
            "mural"
          ]
        },
        "beacon_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "pickup_grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400

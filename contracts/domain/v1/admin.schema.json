        "social_grant_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "mural_cooldown_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500

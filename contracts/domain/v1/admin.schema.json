      "additionalProperties": false,
      "properties": {
        "report_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "target_type": {
          "enum": [
            "USER",
            "POST",
            "COMMENT",
            "PARTY",
            "GIVEAWAY",
            "MURAL"
          ]
        },
        "target_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "OPEN",
            "IN_REVIEW",
            "RESOLVED",
            "DISMISSED"
          ]
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "created_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "report_id",
        "event_id",
        "target_type",
        "target_id",
        "state",
        "revision",
        "created_at"
      ]
    },
    "CreateReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "enum": [
            "USER",
            "POST",
            "COMMENT",
            "PARTY",
            "GIVEAWAY",
            "MURAL"
          ]
        },
        "target_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "enum": [
            "HARASSMENT",
            "PRIVACY",
            "UNSAFE_MEETING",
            "SPAM",
            "OTHER"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "evidence_media_ids": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 4
        }
      },
      "required": [
        "target_type",
        "target_id",
        "reason",
        "text",
        "evidence_media_ids"
      ]
    },
    "ReportDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/admin.schema.json#/$defs/Report"
        },
        "reporter_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64

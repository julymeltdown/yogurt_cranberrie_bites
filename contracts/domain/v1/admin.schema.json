        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "evidence_media_ids": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 4

      "required": [
        "party_id",
        "user_id",
        "role",
        "state",
        "revision",
        "joined_at",
        "event_id"
      ]
    },
    "RemoveMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "party_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "expected_revision",
        "party_revision"
      ]
    },
    "RallyEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "ON_MY_WAY",
            "HERE",
            "MET",
            "NEED_HELP",
            "LEFT"
          ]
        },
        "meeting_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "self_reported_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "user_id",
        "state",
        "meeting_revision",
        "revision",
        "self_reported_at"
      ]
    },
    "Rally": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "party_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "meeting_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "beacon_id": {
          "anyOf": [
            {
              "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/party.schema.json#/$defs/RallyEntry"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "party_id",
        "event_id",
        "meeting_revision",
        "beacon_id",
        "entries"
      ]
    },
    "SetRally": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/CreationRevision"
        },
        "state": {
          "enum": [
            "ON_MY_WAY",
            "HERE",
            "MET",
            "NEED_HELP",
            "LEFT"
          ]
        },
        "meeting_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "physical_presence_acknowledged": {
          "const": true
        }
      },
      "required": [
        "expected_revision",
        "state",
        "meeting_revision",
        "physical_presence_acknowledged"
      ]
    },

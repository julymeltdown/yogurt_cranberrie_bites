    "PartyQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Cursor"
        },
        "ticket_section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "CANCELLED",
            "COMPLETED"
          ]
        },
        "has_space": {
          "type": "boolean"
        },
        "starts_after": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "starts_before": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": []
    },
    "ApplicationQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Cursor"
        },
        "state": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "CANCELLED"
          ]

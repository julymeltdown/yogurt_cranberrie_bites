            "$ref": "https://contracts.mcr.invalid/domain/v1/party.schema.json#/$defs/PartyPublic"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Cursor"

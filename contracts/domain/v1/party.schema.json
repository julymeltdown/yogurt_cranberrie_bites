        "memberships": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/party.schema.json#/$defs/MemberList"
        },
        "applications": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/party.schema.json#/$defs/ApplicationList"
        }
      },
      "required": [
        "owned",
        "memberships",
        "applications"
      ]

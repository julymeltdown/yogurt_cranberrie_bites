      "type": "object",
      "additionalProperties": false,
      "properties": {
        "party_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "owner": {
          "$ref": "https://contracts.mcr.invalid/core/v1/core.schema.json#/$defs/PublicProfile"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "ticket_section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "meeting_starts_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "meeting_ends_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "requirements": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "created_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "CANCELLED",
            "COMPLETED"
          ]
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "public_place_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "meeting_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "party_id",
        "event_id",
        "owner",
        "title",
        "description",
        "ticket_section",
        "capacity",
        "member_count",
        "meeting_starts_at",
        "meeting_ends_at",
        "requirements",
        "created_at",
        "state",
        "revision",
        "public_place_id",
        "meeting_revision"
      ]
    },

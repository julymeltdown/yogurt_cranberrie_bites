    "UpdateParty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "ticket_section": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        },
        "meeting_starts_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "meeting_ends_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "requirements": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "COMPLETED"
          ]
        },
        "public_place_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "expected_revision",
        "title",
        "description",
        "ticket_section",
        "capacity",
        "meeting_starts_at",
        "meeting_ends_at",
        "requirements",
        "state",
        "public_place_id"
      ]

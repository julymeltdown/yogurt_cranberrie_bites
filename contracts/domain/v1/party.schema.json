          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "application_id",
        "event_id",
        "party_id",
        "applicant",
        "note",
        "created_at",
        "state",
        "revision"
      ]
    },
    "Apply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "party_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"

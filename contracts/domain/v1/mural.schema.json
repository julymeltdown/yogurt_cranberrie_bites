{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mcr.invalid/domain/v1/mural.schema.json",
  "title": "MCR C04 mural v0.1.0 review candidate",
  "$defs": {
    "PlacePixel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "color_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": [
        "expected_revision",
        "x",
        "y",
        "color_index"
      ]
    },
    "PixelOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "color_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "committed_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "next_allowed_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "operation_id",
        "event_id",
        "revision",
        "x",
        "y",
        "color_index",
        "committed_at",
        "next_allowed_at"
      ]
    },
    "MuralSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "state": {
          "enum": [
            "EDITABLE",
            "PAUSED",
            "FROZEN"
          ]
        },
        "width": {
          "const": 128
        },
        "height": {
          "const": 128
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "pixels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "minItems": 16384,
          "maxItems": 16384
        },
        "created_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "server_time": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "next_allowed_at": {
          "anyOf": [
            {
              "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "snapshot_id",
        "event_id",
        "revision",
        "state",
        "width",
        "height",
        "palette",
        "pixels",
        "created_at",
        "server_time",
        "cooldown_ms",
        "next_allowed_at"
      ]
    },
    "MuralControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "action": {
          "enum": [
            "PAUSE",
            "RESUME",
            "FREEZE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "expected_revision",
        "action",
        "reason"
      ]
    },
    "RegionLock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "x_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "y_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "x_max_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "y_max_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "locked": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "expected_revision",
        "x_min",
        "y_min",
        "x_max_exclusive",
        "y_max_exclusive",
        "locked",
        "reason"
      ]
    },
    "RestoreMural": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "snapshot_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "expected_revision",
        "snapshot_id",
        "reason"
      ]
    },
    "MuralAdminState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "EDITABLE",
            "PAUSED",
            "FROZEN"
          ]
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "snapshot_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "locks": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/mural.schema.json#/$defs/RegionBounds"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "event_id",
        "state",
        "revision",
        "snapshot_id",
        "locks"
      ]
    },
    "RegionBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "y_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "x_max_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "y_max_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max_exclusive",
        "y_max_exclusive"
      ]
    },
    "MuralDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "from_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "to_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "reset_required": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.mcr.invalid/domain/v1/mural.schema.json#/$defs/PublicPixelOperation"
          },
          "minItems": 0,
          "maxItems": 512
        }
      },
      "required": [
        "event_id",
        "from_revision",
        "to_revision",
        "reset_required",
        "operations"
      ]
    },
    "PublicPixelOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "color_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "committed_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "operation_id",
        "event_id",
        "revision",
        "x",
        "y",
        "color_index",
        "committed_at"
      ]
    },
    "RevisionQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "after_revision"
      ]
    },
    "ArchiveMural": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "event_id": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Uuid"
        },
        "revision": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/Revision"
        },
        "state": {
          "const": "FROZEN"
        },
        "width": {
          "const": 128
        },
        "height": {
          "const": 128
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "pixels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "minItems": 16384,
          "maxItems": 16384
        },
        "created_at": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "server_time": {
          "$ref": "https://contracts.mcr.invalid/domain/v1/common.schema.json#/$defs/UtcTimestamp"
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "next_allowed_at": {
          "type": "null"
        }
      },
      "required": [
        "snapshot_id",
        "event_id",
        "revision",
        "state",
        "width",
        "height",
        "palette",
        "pixels",
        "created_at",
        "server_time",
        "cooldown_ms",
        "next_allowed_at"
      ]
    }
  }
}

//! Gift-only adaptation of canonical fixture610e; all qualification NOT_RUN.
//! Adapted role fixture from EBB operations_public_roles_native.rs (SHA256 69d7cbdff69a617da0290c19fe9de4e76e7c31c250b61b3ac0527de5142ab6b6).
//! Real isolated Auth/Friend/Concert owners, signed issuer and captured Gateway parent.
#[path = "capture.rs"]
mod capture;
#[path = "environment.rs"]
mod environment;
#[path = "owners.rs"]
mod owners;
use chrono::{Duration, SecondsFormat, Utc};
use concert_service::product_rpc::settlement::NativeTransactionResolver;
use concert_service::{
    adapters::out::relationship_authority::guarded::{
        CanonicalOwnerFence, ChildRecoveryReference, OwnerGuardScope,
    },
    config::{canonical_runtime::CanonicalRuntimeCore, native_resolver::NativeResolverUnion},
    operations_live::public_access::{
        composition::PreparedOperationsAuthority,

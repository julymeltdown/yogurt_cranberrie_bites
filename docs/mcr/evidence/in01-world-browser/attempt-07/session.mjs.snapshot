// Real application only. No request interception, mocked service, ticket injection or Auth override.
import {readFile,writeFile,mkdir,mkdtemp,rm,stat,statfs,readdir} from 'node:fs/promises'
import {resolve,extname} from 'node:path'
import {tmpdir} from 'node:os'
import {execFileSync} from 'node:child_process'
import {createHash} from 'node:crypto'
import {createServer} from 'vite'
import {runtimeStatus} from './status.mjs'
import {liveBinding,assertSameLiveBinding,runDirectory} from './guards.mjs'
import {chromium,expect} from '@playwright/test'
const root=resolve(import.meta.dirname,'../../../../..'),front=resolve(root,'frontend'),evidenceRoot=resolve(root,'docs/mcr/evidence/in01-world-browser'),out=runDirectory(evidenceRoot,process.env.MCR_IN01_RUN_ID??('attempt-'+new Date().toISOString().replace(/[:.]/g,'-')))
const git=(...args)=>execFileSync('git',args,{cwd:root,maxBuffer:64*1024**2}),hash=b=>createHash('sha256').update(b).digest('hex')
const descriptorPath=process.env.MCR_IN01_INPUTS
export async function start({localInputPath}={}){
 const d=JSON.parse(await readFile(descriptorPath,'utf8')),binding=liveBinding(d),principals=[]
 if(((await stat(descriptorPath)).mode&0o777)!==0o600)throw Error('PRIVATE_DESCRIPTOR_MODE');process.kill(d.runtime_owner_pid,0)
 await mkdir(evidenceRoot,{recursive:true});await mkdir(out)
 for(const p of d.principals){if(((await stat(p)).mode&0o777)!==0o600)throw Error('PRIVATE_PRINCIPAL_MODE');const v=JSON.parse(await readFile(p,'utf8'));principals.push({email:v.email,password:v.password,id:v.user_id})}
 const report={kind:'IN01-real-browser-v1',status:'IN_PROGRESS',source:git('rev-parse','HEAD').toString().trim(),startedAt:new Date().toISOString(),checks:{},requests:[],captures:[],assets:{},guards:[],errors:[],release:{eventId:d.event_id,room:d.rooms[0],backendSource:d.source_revision,releaseDigest:d.release_digest,gatewayBinary:d.gateway_binary_sha256,concertBinary:d.concert_binary_sha256,protocol:'1.0.0'},qualification:'Actual retained App root, fresh real logins and genuine HTTP/WS only. No fixtures, raw-WS substitution, server process controls or token/credential exports.'}
 const temp=await mkdtemp(resolve(tmpdir(),'mcr-in01-owned-'));const ownProxySockets=[];let server,browser,contexts=[],pages=[],observers=[],finished=false,timer
 async function bytes(p){let n=0;for(const e of await readdir(p,{withFileTypes:true}).catch(()=>[])){const q=resolve(p,e.name);if(e.isDirectory())n+=await bytes(q);else if(e.isFile())n+=(await stat(q)).size}return n}
 async function guard(){const current=assertSameLiveBinding(JSON.parse(await readFile(descriptorPath,'utf8')),binding);if(((await stat(descriptorPath)).mode&0o777)!==0o600)throw Error('PRIVATE_DESCRIPTOR_MODE');process.kill(current.runtime_owner_pid,0);const left=Date.parse(current.expires_at)-Date.now(),disk=await statfs(root),free=disk.bavail*disk.bsize,durable=await bytes(evidenceRoot),output=await bytes(temp)+durable;if(left<15000)throw Error('LIVE_LEASE_EXPIRED');if(free<8*1024**3)throw Error('DISK_BELOW_8GIB');if(output>0.2*1024**3)throw Error('OUTPUT_CAP_0_2GIB');if(durable>40*1024**2)throw Error('DURABLE_CAP_40MIB');report.guards.push({at:new Date().toISOString(),remainingSeconds:Math.floor(left/1000),freeGiB:Number((free/1024**3).toFixed(3)),outputMiB:Number((output/1024**2).toFixed(2)),durableMiB:Number((durable/1024**2).toFixed(2))});return current}
 const clean=s=>String(s).replaceAll(principals[0].password,'[credential]').replaceAll(principals[1].password,'[credential]').replaceAll(principals[0].email,'[principal A]').replaceAll(principals[1].email,'[principal B]').replaceAll(principals[0].id,'[principal A]').replaceAll(principals[1].id,'[principal B]')
 const checkpoint=()=>writeFile(resolve(out,'report.json'),JSON.stringify(report,null,2)+'\n')
 async function check(name,fn){await guard();try{const detail=await fn();report.checks[name]={status:'PASS',detail};await checkpoint();return detail}catch(e){report.checks[name]={status:'FAIL',code:'RUNTIME_ASSERTION',detail:clean(e.message).slice(0,300)};await checkpoint();return {failed:name,code:'RUNTIME_ASSERTION'}}}
 async function shot(name,i=0){const page=pages[i];const file=resolve(out,name+'.png');const masks=principals.map(p=>page.getByText(p.email,{exact:false}));await page.screenshot({path:file,mask:masks});const v={file:file.slice(root.length+1),sha256:hash(await readFile(file))};report.captures.push(v);await checkpoint();return v}
 try{
  await mkdir(out,{recursive:true});report.sourcePins={};for(const p of git('ls-files','frontend/src','contracts').toString().trim().split('\n').filter(p=>/\.(tsx?|css|json)$/.test(p)&&!p.includes('/evidence/')))report.sourcePins[p]=hash(await readFile(resolve(root,p)));for(const name of ['session.mjs','flows.mjs','run.mjs','control.mjs','status.mjs','guards.mjs']){const b=await readFile(resolve(import.meta.dirname,name));report.sourcePins['frontend/e2e/real/world/in01/'+name]=hash(b);await writeFile(resolve(out,name+'.snapshot'),b)};await guard()
  const tracked=new Set(git('ls-files','frontend/public').toString().trim().split('\n'))
  const localRaw=localInputPath?await readFile(localInputPath,'utf8'):process.env.MCR_IN01_LOCAL_INPUT_CONFIG; if(localRaw)report.localInput={path:'backend/releases/operator-bundle/quality-v6/local-input.json',sha256:hash(localRaw),sourceCommit:'837885094297bac1f6fab8e929ff3c8cd9f5b83c'}
  server=await createServer({root:front,configLoader:'runner',cacheDir:resolve(temp,'vite'),logLevel:'error',define:{'import.meta.env.VITE_MCR_EVENT_ID':JSON.stringify(d.event_id),...(localRaw?{'import.meta.env.VITE_MCR_LOCAL_INPUT_CONFIG':JSON.stringify(localRaw)}:{})},plugins:[{name:'exact-tracked-public-assets',configureServer(s){s.middlewares.use((req,res,next)=>{const p='frontend/public'+decodeURIComponent(new URL(req.url,'http://localhost').pathname);if(!tracked.has(p)||!['.png','.jpg','.jpeg','.webp','.ttf'].includes(extname(p)))return next();try{const b=git('show','HEAD:'+p);report.assets[p]={sha256:hash(b),bytes:b.length};res.setHeader('Content-Type',extname(p)==='.ttf'?'font/ttf':'image/'+extname(p).slice(1));res.end(b)}catch{next()}})}}],server:{host:'127.0.0.1',port:5173,strictPort:true,hmr:false,proxy:{'/api':{target:d.gateway_url,changeOrigin:false},'/world-ws':{target:d.world_ws_url.replace(/\/world-ws$/,''),ws:true,changeOrigin:false,configure(proxy){proxy.on('proxyReqWs',(request,_incoming,client)=>{const pair={client,upstream:null};ownProxySockets.push(pair);request.once('upgrade',(_response,upstream)=>{pair.upstream=upstream})})}}}}})
  await server.listen();if(localRaw){const validation=await server.ssrLoadModule('/src/app/world-entry/configuration.ts');if(!validation.readLocalInputConfiguration(localRaw))throw Error('REVIEWED_LOCAL_POLICY_REJECTED');report.localInput.validatedByActualApp=true};const {decode}=await server.ssrLoadModule('/src/world/network/transport/contract.ts')
  process.env.TMPDIR=temp;browser=await chromium.launch({channel:'chrome',headless:true,args:['--disk-cache-size=1048576','--media-cache-size=1048576']});report.browser=browser.version()
  for(let i=0;i<2;i++){
   const context=await browser.newContext({viewport:{width:390,height:844},serviceWorkers:'block'});contexts.push(context);await context.addInitScript(()=>performance.setResourceTimingBufferSize(5000));const page=await context.newPage();pages.push(page);page.setDefaultTimeout(10000);page.setDefaultNavigationTimeout(15000)
   const o={active:0,peak:0,opens:0,snapshots:0,invalid:0,inputs:0,ack:-1,lastInput:0,players:new Map(),baseline:null,frames:0,privacyFields:0};observers.push(o)
   page.on('pageerror',()=>report.errors.push({principal:i,code:'PAGE_ERROR'}))
   page.on('response',r=>{const u=new URL(r.url());if(u.pathname.startsWith('/api/'))report.requests.push({principal:i,path:u.pathname,method:r.request().method(),status:r.status(),at:new Date().toISOString(),correlation:r.headers()['x-request-id']??null})})
   page.on('websocket',ws=>{if(new URL(ws.url()).pathname!='/world-ws')return;o.active++;o.peak=Math.max(o.peak,o.active);o.opens++;let seq=-1
    ws.on('framesent',({payload})=>{try{const m=decode(payload,'client');if(m.type==='input'){o.lastInput=m.seq;if(m.axisX||m.axisY)o.inputs++}}catch{o.invalid++}})
    ws.on('framereceived',({payload})=>{try{const m=decode(payload,'server');o.frames++;if(/"(?:email|password|access_token|refresh_token|social_handles|phone)"/.test(String(payload)))o.privacyFields++;if(m.type==='snapshot'){o.baseline=m;o.snapshots++;seq=0;o.players=new Map(m.players.map(p=>[p.userId,p]));o.ack=m.ackInputSeq}else if(m.type==='delta'){if(!o.baseline||m.streamId!==o.baseline.streamId||m.roomEpoch!==o.baseline.roomEpoch||m.streamSeq!==seq+1){o.invalid++;return}seq=m.streamSeq;m.removes.forEach(id=>o.players.delete(id));m.upserts.forEach(p=>o.players.set(p.userId,p));o.ack=m.ackInputSeq}else if(m.type==='revoke'||m.type==='resyncRequired'){o.players.clear();o.baseline=null}}catch{o.invalid++}})
    ws.on('close',()=>{o.active--;if(o.active===0){o.baseline=null;o.players.clear()}})
   })
  }
  timer=setInterval(()=>guard().catch(async()=>{report.errors.push({code:'RESOURCE_OR_LIVE_GUARD',qualification:'Subsequent driver failures are interrupted work, not product failures'});await finish()}),10000)
  await checkpoint()
 }catch{await finish();throw Error('IN01_START_FAILED_SAFE')}
 function state(){return {checks:report.checks,paths:pages.map(p=>new URL(p.url()).pathname),observers:observers.map(o=>({active:o.active,peak:o.peak,opens:o.opens,snapshots:o.snapshots,invalid:o.invalid,inputs:o.inputs,ack:o.ack,lastInput:o.lastInput,players:o.players.size,frames:o.frames,privacyFields:o.privacyFields,map:o.baseline?.mapId,mapRevision:o.baseline?.mapRevision,avatarManifest:o.baseline?.avatarManifestId,avatarRevision:o.baseline?.avatarManifestVersion})),requests:report.requests.slice(-16),errors:report.errors}}
 async function finish(){if(finished)return;finished=true;clearInterval(timer);for(const c of contexts)await c.close().catch(()=>{});await browser?.close();await server?.close();report.cleanup={contextsClosed:true,browserClosed:true,serverClosed:true,lastObserverActiveBeforeContextClose:observers.map(o=>o.active),socketQualification:'Browser/context closure is verified; passive close callbacks may be detached before notification, server zero requires separate owner observation.'};report.observed=state().observers;report.finishedAt=new Date().toISOString();report.status=runtimeStatus(report.checks,report.errors);await checkpoint();await rm(temp,{recursive:true,force:true})}
 async function login(){return check('independentAccounts',async()=>{for(let i=0;i<2;i++){await pages[i].goto(d.browser_origin+'/login?returnTo=%2Fworld');const submit=pages[i].getByRole('button',{name:'Sign in with email',exact:true});await expect(submit).toBeEnabled({timeout:15000});await pages[i].getByLabel('Email',{exact:true}).fill(principals[i].email);await pages[i].getByLabel('Password',{exact:true}).fill(principals[i].password);const pending=pages[i].waitForResponse(r=>new URL(r.url()).pathname==='/api/auth/login'&&r.request().method()==='POST');await submit.click();const response=await pending;if(!response.ok())throw Error('REAL_LOGIN_REJECTED');const body=await response.json();if(body.userId!==principals[i].id)throw Error('CANONICAL_IDENTITY_MISMATCH')};return {independentContexts:2,freshLogins:2}})}
 async function live(){return check('authorizedWorld',async()=>{for(const p of pages)await expect(p.locator('[data-world-host]')).toContainText('World connected.',{timeout:25000});await expect.poll(()=>observers.every((o,i)=>o.baseline?.selfUserId===principals[i].id&&o.baseline?.eventId===d.event_id&&o.baseline?.roomId===d.rooms[0].room_id&&principals.every(p=>o.players.has(p.id))),{timeout:15000}).toBe(true);for(const p of pages)await expect(p.locator('[data-world-host] canvas')).toHaveCount(1);if(observers.some(o=>o.peak!==1||o.invalid||o.privacyFields))throw Error('WORLD_SEQUENCE_PRIVACY_OR_SOCKET');return state().observers})}
 async function move(){return check('bidirectionalMovementAndAck',async()=>{for(let i=0;i<2;i++){const o=observers[i],peer=observers[1-i],id=principals[i].id,before={...peer.players.get(id).position},count=o.inputs;await pages[i].bringToFront();await pages[i].getByRole('button',{name:'Movement joystick. Arrow keys or W A S D when focused',exact:true}).focus();for(const key of (i===0?['ArrowRight','ArrowDown','ArrowLeft','ArrowUp']:['ArrowDown','ArrowRight','ArrowUp','ArrowLeft'])){await pages[i].keyboard.down(key);try{await pages[i].waitForTimeout(450)}finally{await pages[i].keyboard.up(key)}const p=peer.players.get(id)?.position;if(p&&(p.x!==before.x||p.y!==before.y))break}await expect.poll(()=>{const a=o.players.get(id)?.position,b=peer.players.get(id)?.position;return o.inputs>count&&a&&b&&(b.x!==before.x||b.y!==before.y)&&a.x===b.x&&a.y===b.y&&o.ack>=o.lastInput},{timeout:15000}).toBeTruthy()}return state().observers})}
 async function inspect(i=0){const p=pages[i];return {path:new URL(p.url()).pathname,text:clean(await p.locator('body').innerText()).slice(0,2200),buttons:await p.getByRole('button').allTextContents(),state:state()}}
 async function disconnectOwnProxy(i){await guard();if(!Number.isInteger(i)||i<0||i>=2||ownProxySockets.length!==2||observers[i].opens!==1)throw Error('OWN_PROXY_PAIR_NOT_UNAMBIGUOUS');const pair=ownProxySockets[i];if(!pair||pair.client.destroyed||!pair.upstream||pair.upstream.destroyed)throw Error('OWN_PROXY_PAIR_NOT_LIVE');pair.client.destroy();pair.upstream.destroy();return {method:'Destroyed exactly one own real Vite proxy client/upstream TCP pair; no synthetic WebSocket frames or backend control',principal:i}}
 return {login,live,move,inspect,state,shot,finish,check,pages,observers,disconnectOwnProxy,principals:undefined,descriptor:undefined,guard}
}
